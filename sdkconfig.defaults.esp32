# ESP32-PICO-D4 / original ESP32 specific
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# ESP32-PICO-D4 reports as chip revision v1.0. Do not require the v3.x
# bootloader range used by ESP32-PICO-V3-02 boards.
CONFIG_ESP32_REV_MIN_1=y

# ESP32-PICO-D4 has embedded flash but no embedded PSRAM. Keep PSRAM off;
# heap_caps_malloc(MALLOC_CAP_SPIRAM) callers already fall back gracefully.
# CONFIG_SPIRAM is not set
