# Common defaults for all boards
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000

# HTTP server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y

# LWIP - enough sockets for phone browser + WS + DNS
CONFIG_LWIP_MAX_SOCKETS=16

# WiFi
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# SPIFFS
CONFIG_SPIFFS_MAX_PARTITIONS=1

# FATFS - disable exFAT, enable LFN (needed if fatfs pulled as dependency)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# CONFIG_FATFS_USE_EXFAT is not set

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Larger main task stack for init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
