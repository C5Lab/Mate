# M5Stack AtomS3 specific (ESP32-S3FN8: 8MB flash, no PSRAM)
# https://docs.m5stack.com/en/core/AtomS3
# GC9107 128x128 LCD (same pinout as AtomS3R); Grove HY2.0-4P: TX=G2, RX=G1
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"
CONFIG_JANOS_BOARD_ATOMS3=y

# ESP32-S3FN8 has NO PSRAM -- force it off so PSRAM init can't abort at boot.
# CONFIG_SPIRAM is not set
