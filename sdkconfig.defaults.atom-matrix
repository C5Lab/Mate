# M5Stack ATOM Matrix specific (ESP32-PICO-D4: 4MB flash, no PSRAM, no display)
# https://docs.m5stack.com/en/core/ATOM%20Matrix
# 5x5 WS2812 RGB matrix (not used as a character display).
# Grove HY2.0-4P: TX=G26, RX=G32
CONFIG_JANOS_BOARD_ATOM_MATRIX=y
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
